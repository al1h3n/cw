{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Co-watcher Console",
  "version": "0.1.0",
  "identifier": "io.cowatcher.console",
  "build": {
    "frontendDist": "ui/dist",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Co-watcher Console",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
